# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it will never be committed.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public Razorpay key (starts with rzp_test_ or rzp_live_). Safe to expose
# in frontend code — this is NOT the secret key.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
